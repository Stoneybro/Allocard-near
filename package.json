{
  "name": "allocard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm run sdk:build && pnpm --filter @allocard/web run dev",
    "build": "pnpm run sdk:build && pnpm --filter @allocard/web run build",
    "start": "pnpm --filter @allocard/web run start",
    "test": "pnpm run sdk:test && pnpm --filter @allocard/web test",
    "web:dev": "pnpm --filter @allocard/web run dev",
    "web:build": "pnpm --filter @allocard/web run build",
    "web:test": "pnpm --filter @allocard/web run test",
    "contracts:build": "pnpm --filter @allocard/scripts run contracts:build",
    "contracts:test": "pnpm --filter @allocard/scripts run contracts:test",
    "sdk:build": "pnpm --filter @allocard/delegation-sdk run build",
    "sdk:test": "pnpm --filter @allocard/delegation-sdk run test",
    "demo": "pnpm --filter @allocard/scripts run demo",
    "delegation:check": "pnpm run contracts:test && pnpm run sdk:build && pnpm run sdk:test && pnpm run web:test && pnpm --filter @allocard/web run typecheck && pnpm run web:build",
    "factory:publish": "node packages/delegation-sdk/scripts/deploy-factory.mjs publish",
    "factory:deploy": "node packages/delegation-sdk/scripts/deploy-factory.mjs deploy",
    "shared:deploy": "node packages/delegation-sdk/scripts/deploy-shared.mjs"
  },
  "packageManager": "pnpm@11.28.10"
}
