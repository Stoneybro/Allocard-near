# Copy to apps/web/.env.local. Fill in your own credentials.
# This template configures the current shared-treasury testnet demo.

# Database: one Neon Postgres connection is sufficient.
# Run pnpm --filter @allocard/web run db:migrate after configuring it.
DATABASE_URL=postgresql://user:password@your-neon-host/database?sslmode=require

# Session signing: generate a random secret of at least 32 characters.
SESSION_SECRET=

# Privy: enable email/Google login and embedded NEAR wallets.
# Allow http://localhost:3000 in your Privy app settings for local development.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional: avoids the initial JWKS fetch; update when rotating signing keys.
# PRIVY_JWT_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# NEAR testnet RPC. Keep provider credentials in the server-only NEAR_RPC_URL.
NEXT_PUBLIC_NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_RPC_URL=https://rpc.testnet.near.org

# Shared treasury: a schema-5 deployment matching this release's shared WASM.
# Required for new company activation; this is the contract account, not a
# company reference containing #company_id.
SHARED_TREASURY_ACCOUNT_ID=
# Defaults to packages/contracts/res/allocard_shared.wasm, resolved by the app.
# SHARED_TREASURY_WASM_PATH=/absolute/path/to/allocard_shared.wasm

# Mock USDC: required to reproduce the USDC demo rather than native-NEAR mode.
# Automatic activation funding and faucet top-ups require this token's minter
# to be the configured relayer. A public token address alone is not sufficient.
NEXT_PUBLIC_MOCK_USDC_ACCOUNT_ID=

# Gas sponsorship: use a dedicated funded testnet account and its private key.
# Apply database migrations before enabling. Both flags are needed for the
# gas-sponsored company activation shown in the walkthrough.
NEAR_SPONSOR_ENABLED=false
NEAR_SPONSOR_COMPANY_ENABLED=false
NEAR_RELAYER_ACCOUNT_ID=
NEAR_RELAYER_PRIVATE_KEY=

# NEAR AI Cloud: interprets natural-language spending policies.
# NEARAI_API_KEY is also accepted; configure one spelling, not both.
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
# Optional alternate provider; unused when a NEAR AI key is configured.
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://ws-hjdcclpedbb2egen.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_MODEL=qwen3.8-max

# Research agent: public NEAR adapter identity registered in the app database.
# pnpm --filter @allocard/web run adapter:configure -- --register can configure
# the adapter locally and register its identity. Review generated configuration.
NEAR_ADAPTER_ACCOUNT_ID=
# Set explicitly before adapter:configure: HTTPS origin of your deployed
# packages/research-worker service (no path), not the marketplace listing URL.
ALLOCARD_AGENT_URL=
# At least 32 characters; must match ALLOCARD_AGENT_SECRET on the worker.
ALLOCARD_AGENT_SECRET=
# Optional, only if the worker deployment uses Vercel Deployment Protection.
# ALLOCARD_WORKER_BYPASS=
# Configure the worker separately with ALLOCARD_APP_URL (a reachable app origin),
# ALLOCARD_AGENT_SECRET, NEAR_AI_API_KEY, and NEARAI_MODEL. See its README.

# Optional Aurora Intents widget: cross-chain funding uses mainnet assets and
# cannot fund the testnet demo treasury. Testnet funding uses mock USDC instead.
# The server exposes the widget API key to the browser through /api/aurora/config.
AURORA_INTENTS_API_KEY=
AURORA_INTENTS_ENVIRONMENT=production
# Browser configuration overrides are optional; the server config above suffices.
# NEXT_PUBLIC_AURORA_INTENTS_API_KEY=
# NEXT_PUBLIC_AURORA_INTENTS_ENVIRONMENT=production
