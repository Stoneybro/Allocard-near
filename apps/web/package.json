{
  "name": "@allocard/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @allocard/delegation-sdk run build && cross-env NODE_OPTIONS=\"--dns-result-order=ipv4first --no-network-family-autoselection\" next dev -H 0.0.0.0",
    "build": "pnpm --filter @allocard/delegation-sdk run build && node scripts/verify-ai.mjs && next build",
    "start": "cross-env NODE_OPTIONS=\"--dns-result-order=ipv4first --no-network-family-autoselection\" next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate_db.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:check": "node scripts/check_db.mjs",
    "reimbursement:configure": "node scripts/configure_reimbursement.mjs",
    "adapter:configure": "node scripts/configure_agent_adapter.mjs"
  },
  "dependencies": {
    "@allocard/delegation-sdk": "workspace:*",
    "@aurora-is-near/intents-swap-widget": "7.29.0",
    "@aurora-is-near/intents-swap-widget-standalone": "^7.29.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@neondatabase/serverless": "^1.1.0",
    "@privy-io/node": "^0.35.0",
    "@privy-io/react-auth": "^3.48.1",
    "@radix-ui/react-hover-card": "^1.1.16",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/dagre": "^0.7.54",
    "@vercel/blob": "^2.4.0",
    "@xyflow/react": "^12.11.0",
    "buffer": "6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "dagre": "^0.8.5",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.3",
    "lucide-react": "^1.17.0",
    "near-api-js": "5.1.1",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "3.8.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.10.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "vercel": "^54.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@11.28.10"
}
